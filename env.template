# FalkorDB local Compose needs no ACL credentials. For a hosted, ACL-protected
# server, use the username/password issued for that FalkorDB instance.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Vercel AI Gateway (server-side only). Add your key locally; never commit .env.
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
MODEL_PROVIDER=vercel-ai-gateway
# Select an enabled Gateway model supporting tool calling and JSON mode.
MODEL_NAME=openai/gpt-4o-mini

# Change to a long random value before any non-local deployment.
SESSION_SECRET=replace-with-a-long-random-secret
MAX_UPLOAD_BYTES=250000
CORS_ORIGINS=["http://localhost:5173"]
