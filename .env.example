# FalkorDB connection (compose service name for Docker; localhost for local API)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# OpenAI-compatible extraction provider. Never expose this in frontend variables.
OPENAI_API_KEY=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# Use a random value for any non-local deployment.
SESSION_SECRET=replace-with-a-long-random-secret
MAX_UPLOAD_BYTES=5000000
CORS_ORIGINS=["http://localhost:5173"]
